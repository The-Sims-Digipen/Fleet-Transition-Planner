{
  "name": "fleet-transition-planner",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @fleet/client dev\" \"pnpm --filter @fleet/server dev\"",
    "dev:client": "pnpm --filter @fleet/client dev",
    "dev:server": "pnpm --filter @fleet/server dev",
    "build": "pnpm --filter @fleet/server build && pnpm --filter @fleet/client build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm -r typecheck && pnpm -r test && pnpm --filter @fleet/server build && pnpm --filter @fleet/client build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
