{
  "name": "fleet-transition-planner",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @fleet/web dev\" \"pnpm --filter @fleet/server dev\"",
    "dev:web": "pnpm --filter @fleet/web dev",
    "dev:server": "pnpm --filter @fleet/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
